{
  "CosmosDb": {
    "AccountEndpoint": "https://myaz-cosmos-account.documents.azure.com:443/",

    "AccountKey": "${COSMOS_DB_KEY}",

    "DatabaseName": "DocVaultDb",

    "ContainerName": "documents"
  },

  "BlobStorage": {
    "ConnectionString": "${BLOB_STORAGE_CONNECTION_STRING}",

    "ContainerName": "uploads"
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",

      "Microsoft.AspNetCore": "Warning"
    }
  },

  "AllowedHosts": "*"
}
